# Copy this file to .env and fill in real values.
NODE_ENV=development
PORT=3000

# PostgreSQL connection strings.
# Hosted Postgres (Neon/Supabase) usually needs ?sslmode=require at the end.
DATABASE_URL=postgres://postgres:password@localhost:5432/task_api
# Used by `npm test`. Must be a SEPARATE database: tests wipe its tables.
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/task_api_test

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed origins, or * for any.
CORS_ORIGIN=*

# bcrypt cost factor (higher = slower and stronger).
BCRYPT_ROUNDS=12
