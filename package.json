{
  "name": "task-management-api",
  "version": "1.0.0",
  "description": "A RESTful task management API built with Express.js and PostgreSQL, featuring JWT authentication and Zod validation.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianbihasa/Task-Management-API.git"
  },
  "keywords": [
    "express",
    "postgresql",
    "jwt",
    "zod",
    "rest-api"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/christianbihasa/Task-Management-API/issues"
  },
  "homepage": "https://github.com/christianbihasa/Task-Management-API#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
